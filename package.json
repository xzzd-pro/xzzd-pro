{
  "name": "xzzd",
  "displayName": "Xzzd",
  "version": "1.0.6",
  "description": "A basic Plasmo extension.",
  "author": "chengjy",
  "plasmo": {
    "source": "src",
    "dist": "build"
  },
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build && pnpm run fix:locales",
    "build:firefox": "plasmo build --target=firefox-mv3 --tag=prod && pnpm run fix:firefox:addon-id && pnpm run fix:locales",
    "package": "plasmo package && pnpm run fix:locales",
    "package:firefox": "plasmo package --target=firefox-mv3 --tag=prod && pnpm run fix:firefox:addon-id && pnpm run fix:locales",
    "fix:firefox:addon-id": "node scripts/inject-firefox-addon-id.mjs",
    "fix:locales": "node scripts/inject-locales.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.2.3",
    "@langchain/core": "^1.1.4",
    "@langchain/google-genai": "^2.0.4",
    "@langchain/openai": "^1.1.3",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pdfjs-dist": "^5.4.449",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@parcel/optimizer-data-url": "2.9.3",
    "@parcel/transformer-inline-string": "2.9.3",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.9.17",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.3.3"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "permissions": [
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "https://*/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "xzzd-pro@2444088970.qq.com"
      }
    }
  }
}
